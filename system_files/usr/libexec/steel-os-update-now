#!/usr/bin/bash
# Steel OS: "Update now" from the Steel OS Portal, in a window instead of a
# terminal, with no password (T, 2026-10-18).
#
# Starts the same update the Tuesday timer runs (uupd.service: the system,
# apps and firmware). polkit lets an administrator at the computer start it
# without a password (50-steel-os-updates.rules). Shows what it is doing while
# it runs, then offers "Restart now" when a new version is waiting.

set -uo pipefail

TITLE="Update Steel OS"

# The installer USB's live session has nothing to update: Steel OS is not
# installed yet, and the update only fails with "System not booted via bootc".
if grep -qw rd.live.image /proc/cmdline; then
    yad --info --title="$TITLE" --window-icon=steel-os --buttons-layout=center --button="OK:0" \
        --text="<b>Install Steel OS first.</b>\n\nThis is the installer USB: nothing is installed on this PC yet.\nAfter you install, Steel OS updates itself every Tuesday." 2>/dev/null \
        || echo "Install Steel OS first: the installer USB cannot be updated."
    exit 0
fi

command -v yad >/dev/null 2>&1 || { systemctl start uupd.service; exit; }

# The manual-update service when the system has it (Bazzite's uupd-manual:
# no "is the PC idle" hardware check), else the Tuesday one.
UNIT=uupd.service
systemctl cat uupd-manual.service >/dev/null 2>&1 && UNIT=uupd-manual.service

# A thick orange bar (/usr/share/steel-os/progress.css), when this yad can
# style its window (T, 2026-10-19: the default bar was a thin gray line).
STYLE=()
yad --help-all 2>/dev/null | grep -q -- '--css' && [[ -r /usr/share/steel-os/progress.css ]] \
    && STYLE=(--css=/usr/share/steel-os/progress.css)

log="$(mktemp)"
since="$(date '+%Y-%m-%d %H:%M:%S')"
# An update may already be running: the Tuesday one starts when a laptop
# that slept through midnight wakes up, and a second one would only fail with
# "could not acquire lock" (T's wife's laptop, STEEL-81, 2026-10-20). Then
# this window follows the running update instead of starting another.
running=""
for u in uupd-manual.service uupd.service; do
    systemctl is-active --quiet "$u" 2>/dev/null && { running="$u"; break; }
done
if [[ -n "$running" ]]; then
    UNIT="$running"
    started="$(systemctl show -p ActiveEnterTimestamp --value "$UNIT" 2>/dev/null)"
    [[ -n "$started" ]] && since="$(date -d "$started" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$since")"
    HEADING="Steel OS is already updating"
    SUB="It started in the background$( [[ -n "$started" ]] && echo " at $(date -d "$started" '+%H:%M' 2>/dev/null)" ). This window follows it."
    (
        while systemctl is-active --quiet "$UNIT" 2>/dev/null; do sleep 2; done
        [[ "$(systemctl show -p Result --value "$UNIT" 2>/dev/null)" == success ]] && echo 0 > "$log.rc" || echo 1 > "$log.rc"
    ) &
    starter=$!
else
    HEADING="Updating Steel OS"
    SUB="You can keep working. Your files and apps stay as they are."
    (
        systemctl start "$UNIT" >"$log" 2>&1
        echo $? > "$log.rc"
    ) &
    starter=$!
fi

# The window: a real percentage bar and the step in plain words (T,
# 2026-10-19). uupd logs its progress as JSON lines in the journal:
# {"msg":"Updating","title":"System Update","description":"...",
#  "progress":1,"total":4,"overall":37.5}.
plain() { # uupd's step title -> plain English
    case "$1" in
        *[Ss]ystem*) echo "Downloading the new version of Steel OS" ;;
        *[Ff]latpak*) echo "Updating your apps" ;;
        *[Bb]rew*) echo "Updating command-line tools" ;;
        *[Dd]istrobox*) echo "Updating containers" ;;
        *[Ff]irmware*) echo "Checking firmware" ;;
        "") echo "Checking for updates" ;;
        *) echo "$1" ;;
    esac
}
(
    echo 0
    echo "# Checking for updates…"
    while kill -0 "$starter" 2>/dev/null; do
        journal="$(journalctl -u "$UNIT" --since "$since" -o cat --no-pager 2>/dev/null)"
        last="$(jq -Rr 'fromjson? | select(.msg == "Updating") | "\(.overall // 0 | floor)\t\(.title // "")\t\(.progress // 0)\t\(.total // 0)"' \
            <<< "$journal" 2>/dev/null | tail -1)"
        # While Steel OS itself downloads, bootc reports bytes:
        # {"bytes":183146058,...,"bytesTotal":602675186,...,"task":"pulling"}
        # (sometimes inside a log line, with escaped quotes). Use them for an
        # exact download bar (T, 2026-10-19, from a photo of the old update).
        pull="$(grep -E 'bytesTotal' <<< "$journal" | tail -1)"
        if [[ -n "$last" ]]; then
            IFS=$'\t' read -r pct title step total <<< "$last"
            if [[ -n "$pull" && "$title" == *[Ss]ystem* ]]; then
                got="$(grep -oE '[\\]?"bytes[\\]?":[0-9]+' <<< "$pull" | head -1 | grep -oE '[0-9]+$')"
                all="$(grep -oE '[\\]?"bytesTotal[\\]?":[0-9]+' <<< "$pull" | head -1 | grep -oE '[0-9]+$')"
                if [[ -n "$got" && -n "$all" ]] && (( all > 0 && total > 0 )); then
                    # This step's share of the whole bar, filled by the download.
                    pct=$(( ( step * 100 + got * 100 / all ) / total ))   # step counts from 0
                    (( pct > 99 )) && pct=99
                    echo "$pct"
                    echo "# Downloading the new version of Steel OS… $(( got / 1000000 )) of $(( all / 1000000 )) MB"
                    sleep 1
                    continue
                fi
            fi
            (( pct > 99 )) && pct=99
            echo "$pct"
            if (( total > 0 )); then
                echo "# $(plain "$title")… step $(( step + 1 > total ? total : step + 1 )) of $total, $pct%"
            else
                echo "# $(plain "$title")… $pct%"
            fi
        fi
        sleep 1
    done
    echo 100
) | yad --progress "${STYLE[@]}" --percentage=0 --auto-close --no-buttons --center --width=480 --borders=16 \
        --title="$TITLE" --window-icon=steel-os --image=steel-os \
        --text="<b>$HEADING</b>\n$SUB" 2>/dev/null &
win=$!
wait "$starter"
wait "$win" 2>/dev/null

rc="$(cat "$log.rc" 2>/dev/null || echo 1)"
staged="$(rpm-ostree status --json 2>/dev/null | jq -r '[.deployments[] | select(.staged == true)] | length')"
if [[ "$rc" != 0 ]] && grep -q 'acquire lock' "$log" 2>/dev/null; then
    # The update finished (or started) between our check and the start: say so instead of an error.
    kdialog --title "$TITLE" --icon steel-os --msgbox "<h3>Steel OS was already updating</h3><p>Another update was running in the background. Wait a few minutes, then click <b>Update now</b> again to see where it got to.</p>" 2>/dev/null
elif [[ "$rc" != 0 ]] && journalctl -u "$UNIT" --since "$since" -o cat --no-pager 2>/dev/null | grep -qi 'no signature exists\|signature was required'; then
    # A new version was being published at that very moment (the build pushes
    # the image a minute before its signature arrives). Not a fault on this
    # PC: offer to try again shortly (STEEL-87, 2026-10-20).
    if kdialog --title "$TITLE" --icon steel-os --yes-label "Try again" --no-label "Later" --yesno \
        "<h3>A new version is being published right now</h3><p>Steel OS couldn't check the new version's signature because it was still being published. It usually takes a minute or two.</p><p>Try again in a minute? (Steel OS also tries by itself at night.)</p>" 2>/dev/null; then
        ( sleep 75 ) | yad --progress "${STYLE[@]}" --pulsate --auto-close --no-buttons --center --width=420 --borders=16 \
            --title="$TITLE" --window-icon=steel-os --image=steel-os --text="<b>Waiting a minute for the new version…</b>" 2>/dev/null
        rm -f "$log" "$log.rc"
        exec "$0"
    fi
elif [[ "$rc" != 0 ]]; then
    details="$( (cat "$log"; journalctl -u "$UNIT" --since "$since" -o cat --no-pager -n 15) 2>/dev/null \
        | sed 's/&/\&amp;/g; s/</\&lt;/g' | tail -15)"
    kdialog --title "$TITLE" --icon steel-os --sorry "<h3>The update didn't finish</h3>
<p>Steel OS tries again on Tuesday by itself. If this keeps happening, use <b>Report a Problem or Idea</b> in the start menu; these details help:</p><pre>$details</pre>" 2>/dev/null
elif [[ "${staged:-0}" -gt 0 ]]; then
    if kdialog --title "$TITLE" --icon steel-os --yes-label "Restart now" --no-label "Later" --yesno \
        "<h3>The update is ready</h3><p>Restart to start the new version. Your files and apps stay as they are, and the previous version is kept in case you need it.</p>" 2>/dev/null; then
        systemctl reboot
    fi
else
    kdialog --title "$TITLE" --icon steel-os --msgbox "<h3>Steel OS is up to date</h3><p>Your apps were updated too.</p>" 2>/dev/null
fi
rm -f "$log" "$log.rc"
